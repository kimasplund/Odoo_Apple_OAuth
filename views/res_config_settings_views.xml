<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.apple.oauth</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='oauth_providers']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="apple_oauth_provider">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">Apple OAuth Provider</span>
                        <div class="text-muted">
                            Configure Apple OAuth Provider
                        </div>
                        <div class="content-group">
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="auth_oauth_apple_client_id"/>
                                <field name="auth_oauth_apple_client_id"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="auth_oauth_apple_team_id"/>
                                <field name="auth_oauth_apple_team_id"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="auth_oauth_apple_key_id"/>
                                <field name="auth_oauth_apple_key_id"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="auth_oauth_apple_private_key"/>
                                <field name="auth_oauth_apple_private_key"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo> 